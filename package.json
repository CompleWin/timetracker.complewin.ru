{
  "name": "simple-time-tracker",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build -w @stt/web && concurrently -k -n web,api \"npm run dev -w @stt/web\" \"npm run dev -w @stt/api\"",
    "build": "npm run build -w @stt/web && npm run build -w @stt/api",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . && prettier --check .",
    "format": "eslint . --fix && prettier --write .",
    "test": "npm run test -w @stt/shared && npm run test -w @stt/api",
    "test:e2e": "npm run test:e2e -w @stt/web",
    "db:migrate:staging": "npm run db:migrate:staging -w @stt/api",
    "db:migrate:production": "npm run db:migrate:production -w @stt/api",
    "db:backup:production": "npm run db:backup:production -w @stt/api",
    "bot:setup": "npm run bot:setup -w @stt/api --",
    "deploy:staging": "npm run build && npm run deploy:staging -w @stt/api",
    "deploy:production": "npm run build && npm run deploy:production -w @stt/api"
  },
  "overrides": {
    "vite": "$vite"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
