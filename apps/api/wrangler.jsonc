{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stt",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENV": "dev",
    "APP_URL": "http://localhost:5173",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stt-dev",
      "database_id": "stt-dev",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "staging": {
      "vars": {
        "ENV": "staging",
        "APP_URL": "https://stt-staging.complewin.workers.dev",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stt-staging",
          "migrations_dir": "migrations",
        },
      ],
      "workers_dev": true,
    },
    "production": {
      "vars": {
        "ENV": "production",
        "APP_URL": "https://timetracker.complewin.ru",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stt-production",
          "migrations_dir": "migrations",
        },
      ],
      "routes": [{ "pattern": "timetracker.complewin.ru", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
    },
  },
}
