{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "stt",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENV": "dev",
    "APP_URL": "http://localhost:5173",
    "PUBLISHER_NAME": "Local publisher",
    "SUPPORT_EMAIL": "support@example.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stt-dev",
      "database_id": "stt-dev",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "staging": {
      "vars": {
        "ENV": "staging",
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1501",
          "simple": { "limit": 300, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stt-staging",
          "migrations_dir": "migrations",
        },
      ],
      "preview_urls": false,
    },
    "production": {
      "vars": {
        "ENV": "production",
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1502",
          "simple": { "limit": 300, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "stt-production",
          "migrations_dir": "migrations",
        },
      ],
      "preview_urls": false,
    },
  },
}
